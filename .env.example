# homelab-observability configuration
# Copy this file to .env and fill in your values.
#
# On the server this file is written by .github/workflows/deploy.yml from
# GitHub Actions secrets and variables — it is never committed.

# Bare domain, no subdomain, no scheme. Must match homelab-edge's value:
# Grafana is served at grafana.<EDGE_BASE_DOMAIN> by that repo's Caddy.
# Used here only to build GF_SERVER_ROOT_URL, so Grafana generates correct
# absolute links and redirects behind the proxy.
EDGE_BASE_DOMAIN=yourdomain.com

# Grafana admin password.
#
# READ THIS BEFORE THE FIRST DEPLOY. Grafana honours this variable ONLY when
# it initialises its database for the first time. If the stack ever starts
# without it, Grafana writes admin/admin into the volume permanently, and
# setting this afterwards changes nothing — you get a compose file that
# plainly shows a strong password on a Grafana that still accepts
# admin/admin, with nothing anywhere to report the discrepancy.
#
# The deploy workflow guards against this by refusing to start when the
# value is missing or blank. To recover if it has already happened:
#   docker compose down -v && docker compose up -d
# which is safe here — the Grafana volume is a disposable cache, and Git is
# the source of truth (SPEC decision 6 and 13).
GF_SECURITY_ADMIN_PASSWORD=

# Healthchecks.io ping URLs — one per check, both from https://healthchecks.io
# (free tier). These are INVERTED heartbeats: the canary pings only while
# things are healthy, and it is the ABSENCE of a ping that raises the alarm.
#
# Configure both checks in Healthchecks.io as:
#   Period: 5 minutes    Grace: 15 minutes    Notify: email
#
# Email, deliberately not Telegram: if the failure is "the box lost internet",
# a Telegram alert that never arrives is worthless. Healthchecks.io sends
# from its own infrastructure, off this box (SPEC decision 14).

# Pings only when Loki reports > 0 lines received in the last 5 minutes.
# Proves the whole chain: containers -> Docker socket -> Alloy -> Loki -> query API.
HC_PING_URL_PIPELINE=

# Pings only when host disk usage is below DISK_THRESHOLD_PCT.
# Out-of-band on purpose: a full disk is exactly the condition that stops
# Loki, Prometheus and Grafana from writing, so it cannot be alerted through them.
HC_PING_URL_DISK=

# Pings only when host MemAvailable is at or above 10% of MemTotal.
# Out-of-band for the same reason as disk: a box out of memory OOM-kills
# processes and thrashes swap, degrading the stack that would report it.
HC_PING_URL_MEMORY=

# MyCoach health_analytics Postgres datasource (mycoach#117), consumed by
# grafana/provisioning/datasources/mycoach-health-analytics.yml.
#
# mycoach-db publishes no port on any network this stack joins — it's
# reachable only on the host's tailnet address, the network both compose
# projects actually share. Same value as mycoach's own MYCOACH_DB_TAILNET_IP
# (`tailscale ip -4` on this host); not a secret, but must match.
MYCOACH_DB_TAILNET_IP=

# grafana_role's Postgres password (USAGE + SELECT on health_analytics only,
# granted in mycoach's alembic migration 7cf0523de01b). Set the role's actual
# password by hand first — `ALTER ROLE grafana_role WITH LOGIN PASSWORD
# '<value>'` on mycoach-db — per homelab-host/SECRETS.md conventions, then
# put that same value here.
MYCOACH_GRAFANA_DB_PASSWORD=
