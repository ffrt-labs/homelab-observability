  "refresh": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "HRV (7-day avg)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mycoach-health-analytics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mycoach-health-analytics"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT snapshot_date::timestamp AS time, hrv_7day_avg AS value\nFROM health_analytics.daily_metrics\nWHERE $__timeFilter(snapshot_date) AND hrv_7day_avg IS NOT NULL\nORDER BY 1",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "none",
        "textMode": "value"
      }
    },
